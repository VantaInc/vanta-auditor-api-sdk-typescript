+	"testing"
+)
+
+func TestStartupRejectsUntrustedCLIBeforeAuthentication(t *testing.T) {
+	for _, scenario := range []string{"missing", "modified"} {
+		t.Run(scenario, func(t *testing.T) {
+			root := t.TempDir()
+			if scenario == "modified" {
+				if err := os.MkdirAll(filepath.Join(root, "bin"), 0o755); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(root, "bin", "speakeasy"), []byte("not the pinned executable"), 0o755); err != nil {
+					t.Fatal(err)
+				}
+			}
+			cmd := exec.Command(os.Args[0], "-test.run=^TestStartupIntegrityProcess$")
+			cmd.Dir = root
+			cmd.Env = []string{
+				"PATH=/usr/bin:/bin", "HOME=" + root, "SPEAKEASY_ENVIRONMENT=local",
+				"STARTUP_INTEGRITY_TEST=true", "INPUT_ACTION=release", "INPUT_SPEAKEASY_VERSION=pinned",
+			}
+			output, err := cmd.CombinedOutput()
+			if err == nil || (!strings.Contains(string(output), "pinned Speakeasy CLI") && !strings.Contains(string(output), "checksum mismatch")) {
+				t.Fatalf("expected integrity failure before missing authentication/run metadata: %v\n%s", err, output)
+			}
+		})
+	}
+}
+
+func TestStartupIntegrityProcess(t *testing.T) {
+	if os.Getenv("STARTUP_INTEGRITY_TEST") == "" {
+		t.Skip("isolated subprocess helper")
+	}
+	main()
+	t.Fatal("startup accepted an untrusted CLI")
+}
