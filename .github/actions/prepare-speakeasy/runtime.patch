+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+python3 -B - <<'PY'
+import hashlib
+import importlib.util
+import io
+from pathlib import Path
+import tempfile
+from unittest.mock import patch
+import zipfile
+
+spec = importlib.util.spec_from_file_location("installer", "internal/cli/install-pinned-cli.py")
+installer = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(installer)
+archive = io.BytesIO()
+with zipfile.ZipFile(archive, "w") as package:
+    package.writestr("speakeasy", b"extraction sentinel")
+payload = archive.getvalue()
+with tempfile.TemporaryDirectory() as tmp:
+    destination = Path(tmp) / "speakeasy"
+    pin = {"archive_sha256": "0" * 64, "binary_sha256": "0" * 64}
+    with patch.object(installer.zipfile, "ZipFile") as extract:
+        try:
+            installer.install(payload, pin, destination)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError("corrupted archive accepted")
+        extract.assert_not_called()
+    assert not destination.exists(), "archive was extracted before verification"
+    print("rejects_digest_mismatch_before_extraction")
+    pin["archive_sha256"] = hashlib.sha256(payload).hexdigest()
+    try:
+        installer.install(payload, pin, destination)
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("untrusted executable accepted")
+    assert not destination.exists()
+    pin["binary_sha256"] = hashlib.sha256(b"extraction sentinel").hexdigest()
+    installer.install(payload, pin, destination)
+    assert destination.read_bytes() == b"extraction sentinel"
+    assert destination.stat().st_mode & 0o111
+    print("verifies_executable_before_install")
+PY
