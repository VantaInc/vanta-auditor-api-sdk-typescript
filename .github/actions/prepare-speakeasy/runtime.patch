new file mode 100644
index 0000000..38021b1
--- /dev/null
+++ b/internal/configuration/configuration_test.go
@@ -0,0 +1,50 @@
+package configuration
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPinnedModeRejectsVersionOverrides(t *testing.T) {
+	for _, scenario := range []struct {
+		name, version, local string
+		valid                bool
+	}{
+		{name: "pinned", version: "pinned", valid: true},
+		{name: "numeric", version: "1.805.0"},
+		{name: "latest", version: "latest"},
+		{name: "missing"},
+		{name: "local override", version: "pinned", local: "1.803.1"},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			root := t.TempDir()
+			dir := filepath.Join(root, "repo", ".speakeasy")
+			if err := os.MkdirAll(dir, 0o755); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("GITHUB_WORKSPACE", root)
+			t.Setenv("INPUT_WORKING_DIRECTORY", "")
+			data := "workflowVersion: 1.0.0\nsources: {}\ntargets: {}\n"
+			if scenario.version != "" {
+				data += "speakeasyVersion: " + scenario.version + "\n"
+			}
+			if err := os.WriteFile(filepath.Join(dir, "workflow.yaml"), []byte(data), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			if scenario.local != "" {
+				if err := os.WriteFile(filepath.Join(dir, "workflow.local.yaml"), []byte("speakeasyVersion: "+scenario.local+"\n"), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+			wf, err := GetWorkflowAndValidateLanguages(false)
+			if scenario.valid {
+				if err != nil || wf.SpeakeasyVersion.String() != "pinned" {
+					t.Fatalf("valid pinned workflow rejected: %v", err)
+				}
+			} else if err == nil {
+				t.Fatal("workflow can select an unchecked second CLI")
+			}
+		})
+	}
+}
