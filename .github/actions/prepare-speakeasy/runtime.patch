@@ -0,0 +1,60 @@
+package actions
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestUntrustedCLIFailsBeforeReleaseWrites(t *testing.T) {
+	for _, scenario := range []string{"missing", "modified"} {
+		t.Run(scenario, func(t *testing.T) {
+			var requests atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				requests.Add(1)
+				w.WriteHeader(http.StatusNotFound)
+			}))
+			defer server.Close()
+			root := t.TempDir()
+			if scenario == "modified" {
+				if err := os.MkdirAll(filepath.Join(root, "bin"), 0o755); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(root, "bin", "speakeasy"), []byte("#!/bin/sh\nexit 0\n"), 0o755); err != nil {
+					t.Fatal(err)
+				}
+			}
+			cmd := exec.Command(os.Args[0], "-test.run=^TestReleaseIntegrityProcess$")
+			cmd.Dir = root
+			cmd.Env = []string{
+				"PATH=/usr/bin:/bin", "HOME=" + root, "SPEAKEASY_ENVIRONMENT=local",
+				"RELEASE_INTEGRITY_TEST=true", "INPUT_GITHUB_ACCESS_TOKEN=local-dummy",
+				"INPUT_SPEAKEASY_VERSION=pinned", "INPUT_TARGET=vanta",
+				"SPEAKEASY_API_KEY=local-dummy", "GITHUB_SERVER_URL=" + server.URL,
+				"GITHUB_REPOSITORY=proof/repo", "GITHUB_REF=refs/heads/main",
+				"GITHUB_WORKSPACE=" + filepath.Join(root, "workspace"),
+			}
+			if output, err := cmd.CombinedOutput(); err != nil {
+				t.Fatalf("release guard failed: %v\n%s", err, output)
+			}
+			if requests.Load() != 0 {
+				t.Fatalf("release contacted GitHub before validating CLI: %d requests", requests.Load())
+			}
+		})
+	}
+}
+
+func TestReleaseIntegrityProcess(t *testing.T) {
+	if os.Getenv("RELEASE_INTEGRITY_TEST") == "" {
+		t.Skip("isolated subprocess helper")
+	}
+	err := Release()
+	if err == nil || (!strings.Contains(err.Error(), "pinned Speakeasy CLI") && !strings.Contains(err.Error(), "checksum mismatch")) {
+		t.Fatalf("expected early CLI integrity error, got %v", err)
+	}
+}
