@@ -27,0 +30,49 @@ type Git interface {
+//go:embed pinned-cli.json
+var pinnedCLIJSON []byte
+
+type cliPin struct {
+	Version      string `json:"version"`
+	Platform     string `json:"platform"`
+	BinarySHA256 string `json:"binary_sha256"`
+}
+
+func verifiedCLI() (string, string, error) {
+	var pin cliPin
+	if err := json.Unmarshal(pinnedCLIJSON, &pin); err != nil {
+		return "", "", fmt.Errorf("invalid Speakeasy CLI pin: %w", err)
+	}
+	if pin.Version == "" || pin.Platform != runtime.GOOS+"_"+runtime.GOARCH {
+		return "", "", fmt.Errorf("Speakeasy CLI pin requires %s", pin.Platform)
+	}
+	if value := environment.GetPinnedSpeakeasyVersion(); value != "" && value != "pinned" {
+		return "", "", fmt.Errorf("speakeasy_version must be pinned; this action installs CLI %s", pin.Version)
+	}
+	if value := os.Getenv("PINNED_VERSION"); value != "" && value != "pinned" {
+		return "", "", fmt.Errorf("PINNED_VERSION must be pinned")
+	}
+	for _, value := range environment.SpeakeasyEnvVars() {
+		if key, value, ok := strings.Cut(value, "="); ok && key == "PINNED_VERSION" && value != "pinned" {
+			return "", "", fmt.Errorf("CLI environment PINNED_VERSION must be pinned")
+		}
+	}
+	cmdPath := filepath.Join(environment.GetBaseDir(), "bin", "speakeasy")
+	binary, err := os.Open(cmdPath)
+	if err != nil {
+		return "", "", fmt.Errorf("required pinned Speakeasy CLI: %w", err)
+	}
+	defer binary.Close()
+	digest := sha256.New()
+	if _, err := io.Copy(digest, binary); err != nil {
+		return "", "", fmt.Errorf("hash pinned Speakeasy CLI: %w", err)
+	}
+	if fmt.Sprintf("%x", digest.Sum(nil)) != pin.BinarySHA256 {
+		return "", "", fmt.Errorf("Speakeasy CLI %s executable checksum mismatch", pin.Version)
+	}
+	return cmdPath, pin.Version, nil
+}
+
+func VerifyPinnedCLI() error {
+	_, _, err := verifiedCLI()
+	return err
+}
