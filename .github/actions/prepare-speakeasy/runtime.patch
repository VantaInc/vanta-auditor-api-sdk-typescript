diff --git a/internal/cli/speakeasy_test.go b/internal/cli/speakeasy_test.go
new file mode 100644
index 0000000..ce0999d
--- /dev/null
+++ b/internal/cli/speakeasy_test.go
@@ -0,0 +1,137 @@
+package cli
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/speakeasy-api/sdk-generation-action/internal/environment"
+)
+
+type noCLIDownload struct{}
+
+func (noCLIDownload) GetLatestTag() (string, error) {
+	panic("runtime release lookup is forbidden")
+}
+
+func (noCLIDownload) GetDownloadLink(string) (string, string, error) {
+	panic("runtime CLI download is forbidden")
+}
+
+func runPinnedCLIProcess(t *testing.T, scenario string) {
+	t.Helper()
+	root := t.TempDir()
+	cmd := exec.Command(os.Args[0], "-test.run=^TestPinnedCLIProcess$")
+	cmd.Dir = root
+	cmd.Env = []string{
+		"PATH=/usr/bin:/bin", "HOME=" + root, "SPEAKEASY_ENVIRONMENT=local",
+		"PINNED_CLI_TEST_CASE=" + scenario, "PINNED_CLI_MARKER=" + filepath.Join(root, "executed"),
+		"GITHUB_WORKSPACE=" + filepath.Join(root, "workspace"), "INPUT_SPEAKEASY_VERSION=pinned",
+	}
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("%s: %v\n%s", scenario, err, output)
+	}
+}
+
+func TestRequiredCLIRejectsUntrustedBinary(t *testing.T) {
+	for _, scenario := range []string{"missing", "modified", "wrong-version"} {
+		t.Run(scenario, func(t *testing.T) { runPinnedCLIProcess(t, scenario) })
+	}
+}
+
+func TestRequiredCLIUsesReviewedBinaryWithoutNetwork(t *testing.T) {
+	runPinnedCLIProcess(t, "verified")
+}
+
+func TestAllCLIEntryPointsRejectUntrustedBinary(t *testing.T) {
+	runPinnedCLIProcess(t, "modified")
+}
+
+func TestPinnedCLIRejectsVersionOverrides(t *testing.T) {
+	for _, scenario := range []string{"action-version", "environment-version", "extra-environment-version"} {
+		t.Run(scenario, func(t *testing.T) { runPinnedCLIProcess(t, scenario) })
+	}
+}
+
+func TestPinnedCLIProcess(t *testing.T) {
+	scenario := os.Getenv("PINNED_CLI_TEST_CASE")
+	if scenario == "" {
+		t.Skip("isolated subprocess helper")
+	}
+	root := environment.GetBaseDir()
+	if err := os.MkdirAll(filepath.Join(root, "bin"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(environment.GetRepoPath(), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	script := []byte("#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$PINNED_CLI_MARKER\"\ncase \"$*\" in\n'ci pr-description --input -') cat >/dev/null; printf '%s\\n' '{\"title\":\"Reviewed CLI\",\"body\":\"Verified\"}' ;;\n*) printf '%s\\n' 'speakeasy version 1.805.0' ;;\nesac\n")
+	hash := sha256.Sum256(script)
+	pin := cliPin{
+		Version: "1.805.0", Platform: runtime.GOOS + "_" + runtime.GOARCH,
+		BinarySHA256: fmt.Sprintf("%x", hash),
+	}
+	var err error
+	pinnedCLIJSON, err = json.Marshal(pin)
+	if err != nil {
+		t.Fatal(err)
+	}
+	content := script
+	switch scenario {
+	case "modified":
+		content = append(append([]byte{}, script...), []byte("# changed\n")...)
+	case "wrong-version":
+		content = []byte("#!/bin/sh\ntouch \"$PINNED_CLI_MARKER\"\necho 'speakeasy version 1.803.1'\n")
+	case "action-version":
+		t.Setenv("INPUT_SPEAKEASY_VERSION", "1.805.0")
+	case "environment-version":
+		t.Setenv("PINNED_VERSION", "latest")
+	case "extra-environment-version":
+		t.Setenv("INPUT_CLI_ENVIRONMENT_VARIABLES", "PINNED_VERSION=1.803.1")
+	}
+	if scenario != "missing" {
+		if err := os.WriteFile(filepath.Join(root, "bin", "speakeasy"), content, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	version, err := Download("latest", noCLIDownload{})
+	if scenario == "verified" {
+		if err != nil || version != "1.805.0" {
+			t.Fatalf("expected reviewed version, got %q, %v", version, err)
+		}
+		if output, err := runSpeakeasyCommand("--version"); err != nil || !strings.Contains(output, "1.805.0") {
+			t.Fatalf("verified CLI failed: %q, %v", output, err)
+		}
+		result, err := GeneratePRDescription(PRDescriptionInput{})
+		if err != nil || result == nil || result.Title != "Reviewed CLI" {
+			t.Fatalf("verified PR helper failed: %#v, %v", result, err)
+		}
+		return
+	}
+	if err == nil {
+		t.Fatal("untrusted acquisition succeeded")
+	}
+	if err := VerifyPinnedCLI(); err == nil {
+		t.Fatal("untrusted binary passed verification")
+	}
+	if _, err := runSpeakeasyCommand("--version"); err == nil {
+		t.Fatal("common runner executed untrusted binary")
+	}
+	cached := true
+	supportsPRDescriptionCommand = &cached
+	if SupportsPRDescriptionCommand() {
+		t.Fatal("capability probe accepted untrusted binary")
+	}
+	if _, err := GeneratePRDescription(PRDescriptionInput{}); err == nil {
+		t.Fatal("PR description accepted untrusted binary")
+	}
+	if _, err := os.Stat(os.Getenv("PINNED_CLI_MARKER")); !os.IsNotExist(err) {
+		t.Fatal("untrusted executable was started")
+	}
+}
